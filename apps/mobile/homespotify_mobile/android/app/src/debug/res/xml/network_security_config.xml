<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG UNIQUEMENT (dossier src/debug) : autorise le HTTP en clair pour le dev
  local, quel que soit l'hôte — émulateur (10.0.2.2) OU IP LAN du PC pour un
  vrai téléphone (ex. 192.168.x.x), qui varie selon le réseau.
  La build release n'embarque pas cette config → le cleartext y reste bloqué.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
