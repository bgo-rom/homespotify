# Outils et caches locaux
.pnpm-store/
.tool-home/

# État runtime privé — sauvegardé/restauré par les scripts, jamais versionné
backups/
services/api/data/

# Captures réseau potentiellement sensibles
*.pcap
*.pcapng

# --- Dépendances ---
node_modules/

# --- Secrets / environnement (jamais dans git) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials*
**/*credentials*.json
**/*cookies*.json
**/*token*.json

# --- Moteur Antra (outil vendorisé) ---
# Ceinture ET bretelles : `tools/antra/.gitignore` couvre déjà ces chemins,
# mais la clé Premium ne doit pas dépendre d'un fichier du dépôt tiers.
tools/antra/.env
tools/antra/.venv/
tools/antra/antra.log
tools/antra/*.db
tools/antra/**/__pycache__/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Diagnostics expurgés du harnais VPS Phase 4.5 (locaux, non versionnés)
.phase45-diagnostics/

# --- Python : bytecode et caches générés (jamais versionnés) ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Sortie de debug régénérée par tools/spotify-auth-spoof/spotify_isrc_harvest.py
# (écrite, jamais lue par le code)
spclient_raw.json

# Cache Chromium partagé de Playwright (volumineux, régénérable)
storage/playwright-browsers/

# --- Builds / caches ---
dist/
build/
out/
.cache/
.turbo/
.expo/
coverage/
*.tsbuildinfo

# --- Flutter / Android : artefacts et signatures (jamais dans git) ---
.dart_tool/
.gradle/
*.apk
*.aab
*.keystore
*.jks
key.properties

# --- Bases SQLite locales générées ---
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
# Sauvegardes horodatées de la base (jamais dans git)
*.backup-*
data/backups/

# --- Bibliothèque musicale réelle et fichiers audio (jamais dans git) ---
storage/music/*
storage/imports/*
storage/covers/*
storage/cache/*
!storage/music/.gitkeep
!storage/imports/.gitkeep
!storage/covers/.gitkeep
!storage/cache/.gitkeep
# Index du Storage Agent : il contient les chemins relatifs de la bibliothèque
# réelle (donnée personnelle). Régénérable par `storage-index:export`.
storage/storage-agent/*
!storage/storage-agent/.gitkeep
*.flac
*.mp3
*.wav
*.aac
*.m4a
*.ogg
*.opus
*.alac
*.aiff
*.wma
*.ape
*.dsf
*.dff
*.mka
*.wv
*.tak
*.tta
*.caf
*.ac3
*.dts
*.m4b

# --- Temporaires / OS ---
tmp/
temp/
*.tmp
*.bak
Thumbs.db
.DS_Store

# --- IDE ---
.vscode/
.idea/

# Clés SSH et secrets
romainvast
romainvast.pub
*.pem
*.key
**/.ssh/
/storage/
/tools/antra/
