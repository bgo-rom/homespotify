# Modèle d'environnement du shadow Phase 6 — AUCUNE VALEUR SECRÈTE ICI.
#
# Ce fichier est versionné. Les deux secrets sont injectés au déploiement dans
# /etc/homespotify/api-shadow.env (0600, propriétaire homespotify) et ne
# transitent jamais par Git, par une ligne de commande, ni par un journal.
#
# Les marqueurs __A_INJECTER__ font échouer le démarrage si l'injection a été
# oubliée : mieux vaut une API qui refuse de démarrer qu'une API qui tourne
# avec un secret vide.
#
# TOUS les chemins sont ABSOLUS et EXPLICITES. Aucune valeur par défaut
# relative au WorkingDirectory n'est utilisée : sous systemd, un défaut
# relatif écrirait à un endroit imprévisible.

NODE_ENV=production
LOG_LEVEL=info

# Écoute strictement locale. Aucune exposition publique, aucun Caddy, aucun
# DNS, aucun port ouvert dans le pare-feu. 3001 reste réservé aux harnais des
# Phases 4.5 et 5 : le shadow ne doit jamais entrer en collision avec eux.
HOST=127.0.0.1
PORT=3002

# --- Données locales du shadow ---------------------------------------------
DB_PATH=/var/lib/homespotify-shadow/data/runtime.db
COVERS_DIR=/var/lib/homespotify-shadow/covers
INCOMING_DIR=/var/lib/homespotify-shadow/imports/incoming
HOMESPOTIFY_IMPORT_ROOT=/var/lib/homespotify-shadow/imports/incoming
OFFLINE_CACHE_DIR=/var/lib/homespotify-shadow/offline-variants

# MUSIC_DIR n'est JAMAIS la bibliothèque : en mode `cached`, l'audio vient du
# Storage Agent. Ce répertoire reste vide et n'existe que parce que `app.ts`
# le crée au démarrage.
MUSIC_DIR=/var/lib/homespotify-shadow/music-unused

# --- Sauvegardes : désactivées en shadow ------------------------------------
# Le writer de vérité reste Windows ; sauvegarder une copie jetable n'aurait
# aucun sens et écrirait pour rien.
BACKUP_ENABLED=false

# --- Découverte : désactivée en shadow --------------------------------------
# Ces services écrivent en base et appellent des API externes. Le shadow
# qualifie le stockage, pas la découverte.
DISCOVERY_ENABLED=false
SPOTIFY_DISCOVERY_ENABLED=false
APPLE_MUSIC_DISCOVERY_ENABLED=false
DEEZER_DISCOVERY_ENABLED=false

# --- Stockage audio : cached(remote) ----------------------------------------
AUDIO_STORAGE_MODE=cached
AUDIO_REMOTE_BASE_URL=http://10.8.0.2:3100
AUDIO_REMOTE_SHARED_SECRET=__A_INJECTER__
AUDIO_REMOTE_CONNECT_TIMEOUT_MS=2000
AUDIO_REMOTE_HEADERS_TIMEOUT_MS=5000
AUDIO_REMOTE_BODY_IDLE_TIMEOUT_MS=15000
AUDIO_REMOTE_MAX_CONNECTIONS=8

# --- Cache audio : profil « équilibré » du Gate 0 ---------------------------
# 12 Gio de cache pour une bibliothèque de 2,93 Gio : elle tient entièrement,
# avec un facteur 4 de croissance. L'éviction reste donc exceptionnelle, ce
# qui place la production dans le cas nominal validé en Phase 5.
# 6 Gio de plancher libre sur 36 Gio disponibles.
AUDIO_CACHE_ROOT=/var/lib/homespotify-shadow/cache/audio
AUDIO_CACHE_MAX_BYTES=12884901888
AUDIO_CACHE_MIN_FREE_BYTES=6442450944
AUDIO_CACHE_TEMP_MAX_AGE_MS=3600000
AUDIO_CACHE_FILL_ON_FULL_GET=true
AUDIO_CACHE_VERIFY_ON_HIT=size
AUDIO_CACHE_EVICTION_TARGET_RATIO=0.90

# --- Secret applicatif ------------------------------------------------------
AUTH_TOKEN_SECRET=__A_INJECTER__

# Aucune variable LUCIDA_* : l'acquisition distante n'appartient pas au
# périmètre shadow, et son watcher ne doit avoir aucun répertoire à surveiller.
