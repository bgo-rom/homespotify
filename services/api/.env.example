# HomeSpotify API — variables d'environnement (exemple).
# Copier en `.env` (jamais commité) et remplir. Chargé par loadDotEnv() au boot.

# Secret HMAC des access tokens JWT — OBLIGATOIRE en production (32+ caractères).
# AUTH_TOKEN_SECRET=

# Exécutable réservé à l'analyse BPM en arrière-plan. Défaut : `ffmpeg`
# résolu depuis le PATH. Aucun traitement de vitesse temps réel ne l'utilise.
# FFMPEG_PATH=ffmpeg

# Racine des imports isolés par compte :
# <userId>_<username>/{inbox,rejected,processed}. Le nom est figé à la
# création du compte. Aucun fichier existant n'est déplacé au démarrage.
# HOMESPOTIFY_IMPORT_ROOT=../../storage/imports

# --- Import depuis des nœuds possédés et autorisés -------------------------
# Liste d'ORIGINES HTTPS exactes séparées par des virgules. Liste vide = route
# /api/library/fetch-node désactivée. Les chemins et credentials sont refusés ;
# chaque redirection doit rester dans cette allowlist.
# NODE_FETCH_ALLOWED_ORIGINS=https://audio.example.com,https://backup.example.com
# Chemin relatif de recherche du premier nœud autorisé.
# NODE_FETCH_SEARCH_PATH_TEMPLATE=/search?q={query}
# Origines HTTPS exactes pouvant servir le FLAC résolu (CDN inclus).
# NODE_FETCH_MEDIA_ALLOWED_ORIGINS=https://cdn.example.com
# Contrat du nœud : JSON { "downloadUrl": "https://cdn.example.com/..." }.
# NODE_FETCH_REMOTE_RESOLVE_PATH_TEMPLATE=/api/download?trackId={trackId}
# NODE_FETCH_METADATA_TIMEOUT_MS=10000
# NODE_FETCH_MAX_MB=200
# NODE_FETCH_TIMEOUT_MS=600000
# NODE_FETCH_MAX_CONCURRENT=2
# NODE_FETCH_MAX_QUEUED=20

# --- Moteur de recommandation « Swipe Discovery » (V3) --------------------
# Clé API Last.fm : graphe de similarité (track.getSimilar / artist.getSimilar).
# Absente = graphe « non configuré » : le feed sert la file locale existante,
# aucun crash. Obtenir une clé : https://www.last.fm/api/account/create
# LASTFM_API_KEY=
# LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0/
# LASTFM_TIMEOUT_MS=8000

# User-Agent MusicBrainz (canonicalisation ; contact requis par leur politique).
# MUSICBRAINZ_USER_AGENT=HomeSpotify/0.1.0 (contact: vous@example.com)

# --- Recherche catalogue multi-fournisseurs (Discovery) -------------------
# Interrupteur global de la recherche catalogue (/api/discovery/*).
# DISCOVERY_ENABLED=true
# DISCOVERY_DEFAULT_MARKET=FR
# DISCOVERY_DEFAULT_LOCALE=fr-FR
# DISCOVERY_SEARCH_TIMEOUT_MS=10000
# DISCOVERY_PROVIDER_TIMEOUT_MS=6000
# DISCOVERY_CACHE_MAX_ENTRIES=5000

# Base API MusicBrainz (le User-Agent est défini plus haut ; sans lui le
# provider MusicBrainz de la recherche reste désactivé proprement).
# MUSICBRAINZ_API_BASE=https://musicbrainz.org

# Spotify (API Web officielle, flux Client Credentials, secret CÔTÉ SERVEUR
# UNIQUEMENT — jamais dans Flutter ni dans Git). Provider actif seulement si
# le flag ET les deux credentials sont renseignés.
# SPOTIFY_DISCOVERY_ENABLED=false
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_API_BASE=https://api.spotify.com/v1
# SPOTIFY_AUTH_BASE=https://accounts.spotify.com

# Apple Music discovery : réutilise APPLE_MUSIC_* ci-dessus ; ce flag permet
# de couper la recherche Apple sans retirer les secrets MusicKit.
# APPLE_MUSIC_DISCOVERY_ENABLED=true

# Deezer et TIDAL : connecteurs présents mais DÉSACTIVÉS tant que la
# conformité (tokens développeur, conditions d'utilisation) n'est pas
# confirmée — cf. DISCOVERY_CATALOG.md. Aucune variable à renseigner.
