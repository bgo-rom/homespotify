{
  "name": "@homespotify/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API HomeSpotify (Fastify + SQLite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "scan": "tsx src/scripts/scan-cli.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "music-metadata": "^11.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "form-data": "^4.0.3",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
