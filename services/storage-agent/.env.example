# Storage Agent HomeSpotify — configuration d'exemple (Phase 2)
#
# Copier en `.env` À CÔTÉ de ce fichier. Ne JAMAIS committer le `.env` réel :
# il contient le secret partagé avec le VPS.

# Interface d'écoute. 127.0.0.1 en Phase 2 (développement local).
# Le bind 10.8.0.2 (WireGuard) sera appliqué en Phase 3 seulement.
# 0.0.0.0 est refusé par la configuration, y compris explicitement.
STORAGE_AGENT_HOST=127.0.0.1
STORAGE_AGENT_PORT=3100

# Racine de la bibliothèque musicale. Aucun fichier n'est servi hors de là.
STORAGE_AGENT_MUSIC_ROOT=F:\dev\homespotify\storage\music

# Index trackId -> chemin relatif, produit par :
#   pnpm --filter @homespotify/api storage-index:export
STORAGE_AGENT_INDEX_PATH=F:\dev\homespotify\storage\storage-agent\index.json

# Secret HMAC partagé avec le VPS — 32 caractères minimum.
# Générer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_AGENT_SHARED_SECRET=

# IP source autorisée (VPS via WireGuard). Liste séparée par des virgules.
# Aucun CIDR : chaque adresse est déclarée explicitement.
STORAGE_AGENT_ALLOWED_REMOTE_IP=10.8.0.1

# Flux GET simultanés. HEAD et /health ne consomment aucun emplacement.
STORAGE_AGENT_MAX_CONCURRENT_STREAMS=8

# Fenêtre d'acceptation de l'horodatage HMAC, en secondes (5..300).
STORAGE_AGENT_HMAC_MAX_CLOCK_SKEW_SECONDS=60

STORAGE_AGENT_LOG_LEVEL=info

# Scrutation de l'index (ms). 0 = rechargement manuel seulement.
STORAGE_AGENT_INDEX_POLL_INTERVAL_MS=5000
