{
  "name": "homespotify",
  "version": "0.1.0",
  "private": true,
  "description": "Application musicale personnelle auto-hébergée — qualité audio vérifiée",
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @homespotify/api dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @homespotify/api start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @homespotify/api db:migrate"
  }
}
