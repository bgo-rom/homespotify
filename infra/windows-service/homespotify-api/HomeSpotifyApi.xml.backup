<service>
  <id>HomeSpotifyApi</id>
  <name>HomeSpotify API</name>
  <description>Backend public sécurisé de HomeSpotify</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>"F:\dev\homespotify\services\api\dist\server.js"</arguments>
  <workingdirectory>F:\dev\homespotify\services\api</workingdirectory>
  <env name="NODE_ENV" value="production" />
  <env name="HOST" value="0.0.0.0" />
  <env name="PORT" value="3000" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <hidewindow>true</hidewindow>
  <stoptimeout>20sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll" />
  <serviceaccount>
    <username>LocalSystem</username>
  </serviceaccount>
</service>